---
const { baseDomain } = Astro.props;
const year = new Date().getFullYear();
const siteVersion = (import.meta.env.PUBLIC_SITE_VERSION || "1.0.0").slice(
  0,
  8,
);
---

<style>
  footer {
    padding: 1rem clamp(1rem, 3vw, 2rem) 2rem;
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .footer-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    line-height: 1.3;
    width: min(1180px, 100%);
    margin: 0 auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-soft);
  }

  .footer-version {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    margin: 0;
  }

  .footer-container p {
    margin: 0;
  }
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-text-soft);
    text-decoration: none;
  }
  .footer-brand span {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    overflow: hidden;
    border-radius: 50%;
    background: var(--color-surface-2);
    box-shadow: 0 0 0 1px rgba(119, 232, 159, 0.3);
  }
  .footer-brand img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 700px) {
    .footer-container {
      justify-content: center;
      text-align: center;
      gap: 4px 12px;
    }
  }
</style>

<footer>
  <div class="footer-container">
    <a href="#hero" class="footer-brand"
      ><span aria-hidden="true"><img src="/favicon.ico" alt="" /></span>{
        baseDomain
      }</a
    >
    <p>&copy; {year} · Designed for clarity. Built for the edge.</p>
    <p class="footer-version">v{siteVersion}</p>
  </div>
</footer>
