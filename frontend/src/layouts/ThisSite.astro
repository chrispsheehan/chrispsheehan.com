---
import TrafficPulse from "../components/TrafficPulse";

const { githubRepo } = Astro.props;
---

<section id="this-site">
  <div class="section-heading" data-reveal>
    <p class="section-eyebrow">This site</p>
    <h2>A compact example of how I like systems to run.</h2>
    <p class="section-intro">
      This site is intentionally small. It exists to show delivery discipline,
      infrastructure ownership, and a preference for simple systems.
    </p>
  </div>

  <div class="site-story-grid" data-reveal>
    <div class="architecture-card">
      <p class="dashboard-card__eyebrow">Build shape</p>
      <h3>Simple stack, explicit delivery path.</h3>
      <ul class="architecture-list">
        <li>
          <strong>AWS edge delivery</strong>
          <span
            >S3, CloudFront, ACM, and Route53 for a low-complexity public edge.</span
          >
        </li>
        <li>
          <strong>Terraform-managed infrastructure</strong>
          <span
            >Application, infrastructure, and deploy automation kept together.</span
          >
        </li>
      </ul>
    </div>

    <div class="dashboard-card github-card">
      <div class="github-card-content">
        <p class="dashboard-card__eyebrow">Repository</p>
        <h3>Source, workflows,<br />and release evidence.</h3>
        <p class="dashboard-card__body">
          Frontend, infrastructure, and deploy automation live together.
        </p>
        <div class="repo-badge-row">
          <a
            href={`https://github.com/${githubRepo}/releases`}
            target="_blank"
            rel="noopener noreferrer"
            class="github-card-link github-card-link--badge"
            aria-label="Open releases"
          >
            <img
              class="pipeline-badge"
              src={`https://img.shields.io/github/v/release/${githubRepo}?display_name=tag&label=Release`}
              alt="Release version"
            />
          </a>
          <a
            href={`https://github.com/${githubRepo}/actions/workflows/prod_code_deploy.yml`}
            target="_blank"
            rel="noopener noreferrer"
            class="github-card-link github-card-link--badge"
            aria-label="Open code deploy workflow"
          >
            <img
              class="pipeline-badge"
              src={`https://img.shields.io/github/actions/workflow/status/${githubRepo}/prod_code_deploy.yml?label=Code%20deploy`}
              alt="Code deploy workflow status"
            />
          </a>
        </div>
        <a
          href={`https://github.com/${githubRepo}`}
          target="_blank"
          rel="noopener noreferrer"
          class="github-card-link github-card-link--button"
        >
          <div class="github-repo-button">
            <img src="/assets/social/github.png" alt="GitHub" />
            <span>Browse Repository</span>
          </div>
        </a>
      </div>
    </div>
  </div>

  <div data-reveal>
    <TrafficPulse client:load />
  </div>
</section>

<style is:global>
  #this-site .section-heading h2 {
    max-width: none;
  }

  #this-site .section-heading {
    margin-bottom: 1.25rem;
  }

  .site-story-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    width: 100%;
    align-items: stretch;
    position: relative;
    z-index: 1;
  }

  .architecture-card {
    position: relative;
    height: 100%;
    padding: 1.5rem;
    box-sizing: border-box;
    border-radius: 1.25rem;
    clip-path: inset(0 round 1.25rem);
    border: 1px solid var(--color-border-soft);
    background: linear-gradient(
      180deg,
      rgba(16, 35, 28, 0.72) 0%,
      rgba(11, 25, 20, 0.9) 100%
    );
    box-shadow: var(--shadow-card-hover);
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  .architecture-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at top right,
        rgba(35, 191, 160, 0.12),
        transparent 35%
      ),
      linear-gradient(135deg, rgba(255, 255, 255, 0.02), transparent 45%);
    pointer-events: none;
  }

  .architecture-card > * {
    position: relative;
    z-index: 1;
  }

  .architecture-card h3 {
    margin: 0.2rem 0 0.75rem;
    max-width: 20ch;
  }

  .architecture-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .architecture-list li {
    display: grid;
    gap: 0.25rem;
    padding-left: 1rem;
    position: relative;
  }

  .architecture-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7rem;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--color-accent-warm);
    box-shadow: 0 0 0 0.28rem rgba(244, 184, 96, 0.12);
  }

  .architecture-list strong {
    color: var(--color-heading);
  }

  .architecture-list span {
    color: var(--color-text-soft);
  }

  .dashboard-card {
    background: linear-gradient(
      180deg,
      rgba(16, 35, 28, 0.72) 0%,
      rgba(11, 25, 20, 0.9) 100%
    );
    border-radius: 1.25rem;
    padding: 1.5rem;
    max-width: none;
    min-width: 0;
    min-height: 0;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    position: relative;
    text-align: left;
    transition:
      background 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
    border: 1px solid var(--color-border-soft);
    box-shadow: var(--shadow-card-hover);
    overflow: hidden;
  }

  .dashboard-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at top right,
        rgba(35, 191, 160, 0.18),
        transparent 38%
      ),
      linear-gradient(135deg, rgba(255, 255, 255, 0.03), transparent 40%);
    pointer-events: none;
  }

  .dashboard-card:hover {
    background: var(--color-surface-2);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .repo-badge-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, max-content));
    gap: 0.65rem;
    align-items: center;
    justify-content: start;
  }

  .pipeline-badge {
    height: 28px;
    object-fit: contain;
    margin: 0 0 0.25rem;
    display: block;
  }

  .github-repo-button img {
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px;
    max-width: 24px;
    max-height: 24px;
    object-fit: contain;
    display: inline-block;
    flex: 0 0 24px;
  }

  .github-card {
    justify-content: flex-start;
    min-width: 0;
    align-items: flex-start;
    text-align: left;
  }

  .github-card:hover {
    background: linear-gradient(
      180deg,
      rgba(18, 40, 32, 0.8) 0%,
      rgba(12, 27, 22, 0.92) 100%
    );
  }

  .github-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    -webkit-tap-highlight-color: transparent;
  }

  .github-card-link:focus {
    outline: none;
  }

  .github-card-link--badge {
    display: inline-flex;
    border-radius: 999px;
    transition:
      filter 0.2s ease,
      transform 0.2s ease;
  }

  .github-card-link--badge:hover {
    filter: brightness(1.08) saturate(1.05);
    transform: translateY(-2px);
  }

  .github-card-link--button {
    width: 100%;
  }

  .github-card-content {
    border: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    justify-content: flex-start;
    position: relative;
    z-index: 1;
  }

  .github-card h3 {
    max-width: 19ch;
    color: var(--color-heading);
  }

  .traffic-pulse {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.25rem;
    margin-top: 1.25rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border-soft);
    border-radius: 1.25rem;
    background:
      radial-gradient(
        circle at 88% 12%,
        rgba(244, 184, 96, 0.13),
        transparent 28%
      ),
      linear-gradient(
        180deg,
        rgba(16, 35, 28, 0.8) 0%,
        rgba(11, 25, 20, 0.94) 100%
      );
    box-shadow: var(--shadow-card-hover);
    overflow: hidden;
  }

  .traffic-pulse--status {
    min-height: 10rem;
    align-content: center;
  }

  .traffic-pulse--status p:last-child {
    margin: 0;
    color: var(--color-text-soft);
  }

  .traffic-pulse__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .traffic-pulse__header h3 {
    margin: 0.2rem 0 0;
    color: var(--color-heading);
    font-size: 1.65rem;
  }

  .traffic-pulse__intro {
    margin: 0.35rem 0 0;
    color: var(--color-text-soft);
  }

  .traffic-pulse__ranges {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border: 1px solid rgba(185, 242, 200, 0.14);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.16);
  }

  .traffic-pulse__ranges button {
    min-width: 2.85rem;
    padding: 0.45rem 0.7rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-text-soft);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
  }

  .traffic-pulse__ranges button:hover,
  .traffic-pulse__ranges button.is-active {
    background: rgba(127, 217, 179, 0.14);
    color: var(--color-heading);
  }

  .traffic-pulse__ranges button:focus-visible {
    outline: 2px solid var(--color-hover);
    outline-offset: 2px;
  }

  .traffic-pulse__body {
    display: grid;
    grid-template-columns: minmax(12rem, 0.42fr) minmax(18rem, 1fr);
    grid-template-areas:
      "headline chart"
      "metrics chart";
    gap: 1.25rem 2rem;
    align-items: end;
  }

  .traffic-pulse__headline {
    grid-area: headline;
    display: flex;
    align-items: flex-end;
    gap: 0.8rem;
    min-width: 0;
  }

  .traffic-pulse__number {
    color: var(--color-heading);
    font-family: var(--font-heading);
    font-size: clamp(3.6rem, 8vw, 6.4rem);
    font-weight: 700;
    line-height: 0.82;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
  }

  .traffic-pulse__headline-copy {
    display: grid;
    gap: 0.12rem;
    color: var(--color-text-soft);
    font-size: 0.9rem;
    line-height: 1.25;
  }

  .traffic-pulse__headline-copy strong {
    color: var(--color-accent-warm);
    font-weight: 700;
  }

  .traffic-pulse__chart-wrap {
    grid-area: chart;
    min-width: 0;
  }

  .traffic-pulse__chart {
    display: grid;
    grid-template-columns: repeat(30, minmax(4px, 1fr));
    align-items: end;
    gap: clamp(2px, 0.45vw, 6px);
    height: 12rem;
    padding: 0.75rem 0.35rem 0.35rem;
    border-bottom: 1px solid rgba(185, 242, 200, 0.2);
    background-image: linear-gradient(
      to bottom,
      rgba(185, 242, 200, 0.08) 1px,
      transparent 1px
    );
    background-size: 100% 25%;
  }

  .traffic-pulse__chart:has(> button:nth-child(14):last-child) {
    grid-template-columns: repeat(14, minmax(4px, 1fr));
  }

  .traffic-pulse__chart:has(> button:nth-child(7):last-child) {
    grid-template-columns: repeat(7, minmax(4px, 1fr));
  }

  .traffic-pulse__chart button {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: 100%;
    min-width: 0;
    padding: 0;
    border: 0;
    border-radius: 0.35rem 0.35rem 0 0;
    background: transparent;
    cursor: pointer;
  }

  .traffic-pulse__bar {
    width: 100%;
    height: var(--bar-height);
    min-height: 2px;
    border-radius: 0.35rem 0.35rem 0.12rem 0.12rem;
    background: linear-gradient(
      180deg,
      var(--color-accent-warm),
      var(--color-accent)
    );
    opacity: 0.58;
    transform-origin: bottom;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      filter 0.18s ease;
  }

  .traffic-pulse__chart button:hover .traffic-pulse__bar,
  .traffic-pulse__chart button:focus-visible .traffic-pulse__bar,
  .traffic-pulse__chart button.is-selected .traffic-pulse__bar {
    opacity: 1;
    filter: drop-shadow(0 0 0.35rem rgba(244, 184, 96, 0.28));
    transform: scaleX(1.14);
  }

  .traffic-pulse__chart button:focus-visible {
    outline: 2px solid var(--color-hover);
    outline-offset: 2px;
  }

  .traffic-pulse__axis {
    display: flex;
    justify-content: space-between;
    padding-top: 0.35rem;
    color: var(--color-text-soft);
    font-size: 0.78rem;
  }

  .traffic-pulse__metrics {
    grid-area: metrics;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .traffic-pulse__metrics div {
    display: grid;
    gap: 0.2rem;
    padding-top: 0.7rem;
    border-top: 1px solid rgba(185, 242, 200, 0.14);
  }

  .traffic-pulse__metrics span {
    color: var(--color-text-soft);
    font-size: 0.74rem;
    line-height: 1.2;
  }

  .traffic-pulse__metrics strong {
    color: var(--color-heading);
    font-size: 0.94rem;
    font-variant-numeric: tabular-nums;
  }

  .github-repo-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 56px;
    padding: 14px 18px;
    border-radius: 0.95rem;
    background: linear-gradient(
      135deg,
      rgba(11, 25, 20, 0.96) 0%,
      rgba(22, 49, 39, 0.94) 100%
    );
    color: var(--color-text);
    font-weight: 700;
    white-space: nowrap;
    font-size: 1.05rem;
    border: 1px solid rgba(185, 242, 200, 0.16);
    box-sizing: border-box;
    transition:
      background 0.2s ease,
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .github-card-link:hover .github-repo-button {
    background: linear-gradient(
      135deg,
      rgba(18, 40, 32, 0.98) 0%,
      rgba(36, 66, 56, 0.96) 100%
    );
    border-color: var(--color-border-strong);
    transform: translateY(-1px);
  }

  .dashboard-card__eyebrow {
    margin: 0;
    color: var(--color-heading);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dashboard-card h3 {
    margin: 0;
    font-size: 1.3rem;
    color: var(--color-text);
    max-width: 18ch;
  }

  .dashboard-card__body {
    margin: 0;
    color: var(--color-text-soft);
  }

  .dashboard-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .dashboard-card li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 1rem;
    width: 100%;
    margin-bottom: 0.5rem;
    font-size: 1rem;
  }

  .dashboard-card strong {
    font-weight: 600;
    color: var(--color-heading);
    min-width: 0;
  }

  .dashboard-notes {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.25rem;
  }

  .dashboard-notes li {
    grid-template-columns: 1fr;
    gap: 0;
    margin: 0;
    padding-left: 1rem;
    position: relative;
    color: var(--color-text-soft);
  }

  .dashboard-notes li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 0.3rem rgba(35, 191, 160, 0.12);
  }

  .metric-value {
    font-weight: 700;
    color: var(--color-hover);
    font-variant-numeric: tabular-nums;
    justify-self: end;
    text-align: right;
    white-space: nowrap;
  }

  .dashboard-card small {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--color-text);
  }

  .github-card-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 1.25rem;
  }

  .github-card-link--badge:focus-visible {
    border-radius: 999px;
  }

  .dashboard-card:focus-within {
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-border-strong);
  }

  @media (max-width: 1000px) {
    .site-story-grid {
      grid-template-columns: 1fr;
    }

    .repo-badge-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-start;
    }

    .dashboard-card,
    .github-card {
      margin-left: auto;
      margin-right: auto;
      width: 100%;
      min-width: unset;
      max-width: unset;
    }

    .github-repo-button img {
      width: 22px;
      height: 22px;
      min-width: 22px;
      min-height: 22px;
      max-width: 22px;
      max-height: 22px;
      flex-basis: 22px;
    }

    .traffic-pulse__body {
      grid-template-columns: 1fr;
      grid-template-areas:
        "headline"
        "chart"
        "metrics";
    }
  }

  @media (max-width: 620px) {
    .traffic-pulse {
      padding: 1.15rem;
    }

    .traffic-pulse__header {
      display: grid;
    }

    .traffic-pulse__ranges {
      justify-self: start;
    }

    .traffic-pulse__chart {
      height: 9rem;
    }

    .traffic-pulse__metrics {
      grid-template-columns: 1fr;
    }
  }
</style>
