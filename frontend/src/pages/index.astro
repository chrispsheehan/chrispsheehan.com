---
import Header from "../layouts/Header.astro";
import Footer from "../layouts/Footer.astro";
import ThisSite from "../layouts/ThisSite.astro";
import AboutMe from "../layouts/AboutMe.astro";
import Certifications from "../layouts/Certifications.astro";
import SelectedWork from "../layouts/SelectedWork.astro";

const baseDomain = import.meta.env.DEV
  ? "local.chrispsheehan.com"
  : "chrispsheehan.com";
const githubRepo =
  import.meta.env.GITHUB_REPOSITORY ?? "chrispsheehan/chrispsheehan.com";
const githubProfile = "https://github.com/chrispsheehan";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chris Sheehan | Senior Platform Engineer</title>
    <meta
      name="description"
      content="Chris Sheehan is a senior platform engineer building dependable AWS platforms, Terraform foundations, and CI/CD delivery paths."
    />
    <link rel="canonical" href="https://chrispsheehan.com/" />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Chris Sheehan | Senior Platform Engineer"
    />
    <meta
      property="og:description"
      content="AWS platforms, Terraform foundations, and CI/CD delivery paths built to help teams ship safely."
    />
    <meta property="og:url" content="https://chrispsheehan.com/" />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body>
    <Header baseDomain={baseDomain} githubRepo={githubRepo} />

    <main class="home-shell">
      <section id="hero" class="hero-section">
        <div class="hero-copy" data-reveal>
          <p class="section-eyebrow">
            Chris Sheehan · Senior Platform Engineer
          </p>
          <h1>I build the paved roads that help teams ship safely.</h1>
          <p class="hero-intro">
            AWS platforms, Terraform foundations, and CI/CD delivery paths
            designed for speed without giving up confidence.
          </p>
          <div class="cta-row">
            <a class="button-link button-link--primary" href="#selected-work">
              View selected work
            </a>
            <a
              class="button-link button-link--ghost"
              href={githubProfile}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub ↗
            </a>
          </div>
          <div class="profile-links" aria-label="Professional profiles">
            <a
              class="profile-link"
              href="https://www.linkedin.com/in/chrispsheehan"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src="/assets/social/linkedin.png"
                alt=""
                aria-hidden="true"
              />
              LinkedIn
            </a>
            <a
              class="profile-link"
              href="https://registry.terraform.io/namespaces/chrispsheehan"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src="/assets/social/terraform.png"
                alt=""
                aria-hidden="true"
              />
              Terraform Registry
            </a>
          </div>
        </div>

        <aside class="hero-panel" data-reveal>
          <div class="hero-panel-card hero-panel-card--accent">
            <p class="section-eyebrow">A dependable delivery path</p>
            <h2>From change to useful signal.</h2>
            <div
              class="delivery-flow"
              aria-label="Commit, plan, promote, observe"
            >
              <div class="delivery-step">
                <span>01</span>
                <strong>Commit</strong>
                <small>Small, reviewable change</small>
              </div>
              <div class="delivery-step">
                <span>02</span>
                <strong>Plan</strong>
                <small>Visible impact before apply</small>
              </div>
              <div class="delivery-step">
                <span>03</span>
                <strong>Promote</strong>
                <small>Controlled path to production</small>
              </div>
              <div class="delivery-step">
                <span>04</span>
                <strong>Observe</strong>
                <small>Evidence that the system works</small>
              </div>
            </div>
          </div>
        </aside>
      </section>

      <SelectedWork />

      <AboutMe />

      <ThisSite githubRepo={githubRepo} />

      <Certifications />
    </main>

    <Footer baseDomain={baseDomain} />
  </body>
</html>
